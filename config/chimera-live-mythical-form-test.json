{
  "name": "gafee-chimera-mythical-form-test",
  "mode": "execute",
  "scope": {
    "battleKind": "AllianceChimera"
  },
  "team": {
    "heroIds": [39104, 21597, 34700, 21826, 26679]
  },
  "objectives": {
    "mandatoryTrialIds": [],
    "minimumDamage": 0,
    "onMandatoryTrialImpossible": "free_regroup_and_retry_manual",
    "maxRegroupRetries": 0,
    "onAllMetAtResult": "hold_for_user"
  },
  "safety": {
    "requireManualCommandWindow": true,
    "requireAcceptableTargetSet": true,
    "requireFreshSnapshotMs": 1500,
    "maxCommandsPerTurn": 1,
    "onUnknownState": "pause",
    "onNoMatchingRule": "pause"
  },
  "rules": [
    {
      "name": "御影夫人：原形态主动切换",
      "when": {
        "activeHeroTypeId": 8256,
        "activeHeroFormIndex": 0,
        "activeHeroIsMetamorph": true,
        "activeHeroIsTransformed": false,
        "transformationReady": true
      },
      "action": {"type": "transform"}
    },
    {
      "name": "御影夫人：变形形态技能3攻击奇美拉",
      "when": {
        "activeHeroTypeId": 8256,
        "activeHeroFormIndex": 1,
        "activeHeroIsMetamorph": true,
        "activeHeroIsTransformed": true
      },
      "action": {"type": "cast", "skillSlot": 3, "target": {"type": "boss"}}
    },
    {
      "name": "御影夫人：变形形态技能3对自己",
      "when": {"activeHeroTypeId": 8256, "activeHeroFormIndex": 1},
      "action": {"type": "cast", "skillSlot": 3, "target": {"type": "self"}}
    },
    {
      "name": "御影夫人：变形形态技能2攻击奇美拉",
      "when": {"activeHeroTypeId": 8256, "activeHeroFormIndex": 1},
      "action": {"type": "cast", "skillSlot": 2, "target": {"type": "boss"}}
    },
    {
      "name": "御影夫人：变形形态技能1攻击奇美拉",
      "when": {"activeHeroTypeId": 8256, "activeHeroFormIndex": 1},
      "action": {"type": "cast", "skillSlot": 1, "target": {"type": "boss"}}
    },
    {
      "name": "常规英雄：技能3给生命最低友方",
      "when": {"activeHeroIsMetamorph": false},
      "action": {"type": "cast", "skillSlot": 3, "target": {"type": "lowestHpAlly"}}
    },
    {
      "name": "常规英雄：技能3攻击奇美拉",
      "when": {"activeHeroIsMetamorph": false},
      "action": {"type": "cast", "skillSlot": 3, "target": {"type": "boss"}}
    },
    {
      "name": "常规英雄：技能2给生命最低友方",
      "when": {"activeHeroIsMetamorph": false},
      "action": {"type": "cast", "skillSlot": 2, "target": {"type": "lowestHpAlly"}}
    },
    {
      "name": "常规英雄：技能2攻击奇美拉",
      "when": {"activeHeroIsMetamorph": false},
      "action": {"type": "cast", "skillSlot": 2, "target": {"type": "boss"}}
    },
    {
      "name": "常规英雄：技能1攻击奇美拉",
      "when": {"activeHeroIsMetamorph": false},
      "action": {"type": "cast", "skillSlot": 1, "target": {"type": "boss"}}
    },
    {
      "name": "御影夫人：原形态变形不可用时技能1",
      "when": {"activeHeroTypeId": 8256, "activeHeroFormIndex": 0},
      "action": {"type": "cast", "skillSlot": 1, "target": {"type": "boss"}}
    }
  ]
}
